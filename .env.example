# Host browser port. Keep the Compose binding on 127.0.0.1.
PERSONA_HTTP_PORT=7862

# Optional: keep private persona files outside this Git checkout.
# PERSONA_DATA_DIR=/absolute/path/to/private/personas

# Prompt enhancement is enabled when the pinned PE-T2I / PE-I2I models are installed.
# PERSONA_PROMPT_ENHANCER=1
# auto: use host vLLM when available, otherwise the slower in-container fallback.
# PERSONA_PE_BACKEND=auto

# Regional torch.compile is enabled by default for Qwen-Image-2.1 on GB10.
# Set to 0 only for troubleshooting or comparison with eager inference.
# PERSONA_TORCH_COMPILE=1

# GB10 DiT quantization. off (default) keeps BF16 regional compile;
# dynamic applies torchao FP8 dynamic activation+weight before regional
# compile (fastest same-shape, slower on new prompt shapes); weight-only is
# a memory-only mode (slower here).
# PERSONA_FP8=off

# Default generation steps for the UI/API (1-80 selectable at runtime).
# PERSONA_DEFAULT_STEPS=20

# Built-in Gradio theme. Ocean is the reviewed default.
# PERSONA_THEME=ocean
