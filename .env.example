# Host browser port. Keep the Compose binding on 127.0.0.1.
PERSONA_HTTP_PORT=7862

# Optional: keep private persona files outside this Git checkout.
# PERSONA_DATA_DIR=/absolute/path/to/private/personas

# Prompt enhancement is enabled when the pinned PE-T2I / PE-I2I models are installed.
# PERSONA_PROMPT_ENHANCER=1
# auto: use host vLLM when available, otherwise the slower in-container fallback.
# PERSONA_PE_BACKEND=auto

# Built-in Gradio theme. Ocean is the reviewed default.
# PERSONA_THEME=ocean
